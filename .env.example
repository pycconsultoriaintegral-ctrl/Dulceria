# Copia este archivo a .env y completa los valores
# Dominio con HTTPS. Sin dominio propio usa <IP-con-guiones>.sslip.io, ej: 203-0-113-10.sslip.io
APP_DOMAIN=203-0-113-10.sslip.io
# Genera con: openssl rand -hex 32
JWT_SECRET=
# Contraseña inicial del usuario "admin" (solo se usa la primera vez)
ADMIN_PASSWORD=
TZ_NEGOCIO=America/Bogota
